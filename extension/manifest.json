{
  "manifest_version": 3,
  "name": "VanishX Companion",
  "version": "2.0.0",
  "description": "Companion extension for VanishX. Executes client-side timeline purges and bot cleansing in active X.com tabs.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://vanishx.vercel.app/*",
    "https://*.vercel.app/*",
    "https://x-account-cleaner.vercel.app/*",
    "http://localhost:3000/*",
    "http://localhost:*/*",
    "http://127.0.0.1:3000/*",
    "http://127.0.0.1:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://vanishx.vercel.app/*",
        "https://*.vercel.app/*",
        "https://x-account-cleaner.vercel.app/*",
        "http://localhost:3000/*",
        "http://localhost:*/*",
        "http://127.0.0.1:3000/*",
        "http://127.0.0.1:*/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VanishX",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
